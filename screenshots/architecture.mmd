---
title: Omarchy 4.0 · system architecture and the AI agent's control path
---
flowchart LR
  subgraph AGENT["AGENT PLANE"]
    direction TB
    skills["<b>Shipped skills</b><br/>omarchy · diagnose-crash<br/><i>symlinked into every agent</i>"]
    agent["<b>AI agent</b><br/>Claude Code · Codex · OpenCode · Hermes<br/>launched by <code>omarchy agent</code><br/><i>unattended mode by default</i>"]
    crash["<b>Crash assistant</b><br/>watches coredumps → opens agent"]
    skills -- loads --> agent
    crash -. opens .-> agent
  end

  subgraph CONTROL["CONTROL PLANE · omarchy CLI (bash)"]
    direction TB
    cli["<b>omarchy dispatcher</b><br/>367 commands · 63 groups<br/><code>omarchy commands --json</code> = machine-readable map"]
    gate["<b>Privilege gate</b><br/>pkexec → polkit → user approves<br/><i>or full sudo for 15 min, nothing in between</i>"]
    update["<b>omarchy update</b><br/>snapshot → pacman -Syu → 106 migrations → hooks"]
    repo[("<b>[omarchy] repo + Arch mirror</b><br/>~1 month behind Arch")]
    cli -- "83 root cmds" --> gate
    repo --> update
  end

  subgraph SESSION["SESSION · Wayland"]
    direction TB
    hypr["<b>Hyprland 0.56</b><br/>Lua config · reloads on save"]
    qs["<b>Quickshell</b> · one QML process<br/>bar · launcher · notifications<br/>lock · idle · polkit dialog"]
  end

  subgraph DISK["STORAGE · LUKS2 → btrfs"]
    direction LR
    root[("<b>@ root</b><br/>/usr/share/omarchy · /etc<br/>owned by root<br/>✓ snapshot before every update")]
    home[("<b>@home</b><br/>~/.config/hypr · ~/.config/omarchy<br/>~/.local/state/omarchy<br/>✗ no snapshot · no log · no undo")]
  end

  boot["<b>Boot</b> · Limine → linux-omarchy → SDDM → uwsm<br/>✓ 5 newest snapshots are boot entries"]

  agent -- exec --> cli
  agent == "① writes (RW)" ==> home
  agent -. "write → EACCES" .-x root
  home == "② hot reload" ==> hypr
  hypr -. "③ hyprctl configerrors" .-> agent
  gate -- dialog --> qs
  update -- snapper --> root
  root --> boot
  boot --> hypr

  gap["<b>The gap</b>: the system layer rolls back, the layer agents write to does not.<br/>R11 → snapshot @home at agent start · log changes · <code>omarchy agent undo</code>"]
  home --- gap

